# Copy this file to .env and fill in real values. See backend/app/config.py for the schema
# these are read into (isik.common.config) - any variable without a documented default below
# is required.

# Required. Signs and encrypts the session cookie - generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Optional - defaults shown.

# Where the SQLite database file lives. The Docker image already sets this to /app/data/...
# and declares /app/data as a volume - point Coolify's persistent storage mount there.
# DATABASE_PATH=./data/brennkonto.sqlite3

# Keep this True behind HTTPS (Coolify's default). Set to False only for local http:// dev,
# otherwise the browser will silently refuse to store the session cookie.
# SESSION_COOKIE_SECURE=True

# Comma-separated list of origins allowed to call the API with credentials. Only needed when
# the frontend is served from a different origin than the API (e.g. local Vite dev server) -
# in the single-container deploy the frontend and API share an origin, so this can stay empty.
# CORS_ALLOW_ORIGINS=http://localhost:5173

# Open Food Facts requests a descriptive User-Agent for API clients - see
# https://world.openfoodfacts.org/data for the underlying dataset and API docs.
# OFF_USER_AGENT=Brennkonto/0.1 (github.com/isik-kaplan/brennkonto)
# OFF_BASE_URL=https://world.openfoodfacts.org
# OFF_SEARCH_BASE_URL=https://search.openfoodfacts.org
